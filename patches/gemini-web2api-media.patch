+def detect_media_mime(media_bytes: bytes, fallback: str = "") -> str:
+    """Infer image/audio/video MIME from signature; keep the declared type if unknown."""
+    fallback = (fallback or "").split(";", 1)[0].strip().lower()
+    image = detect_image_mime(media_bytes, "")
+    if image:
+        return image
+    if not isinstance(media_bytes, bytes):
+        return fallback
+    if media_bytes.startswith(b"OggS"):
+        return "audio/ogg"
+    if media_bytes.startswith(b"fLaC"):
+        return "audio/flac"
+    if media_bytes.startswith(b"RIFF") and media_bytes[8:12] == b"WAVE":
+        return "audio/wav"
+    if media_bytes.startswith(b"ID3") or media_bytes[:2] in (b"\xff\xfb", b"\xff\xf3", b"\xff\xf2"):
+        return "audio/mpeg"
+    if len(media_bytes) >= 12 and media_bytes[4:8] == b"ftyp":
+        brand = media_bytes[8:12]
+        if brand in (b"M4A ", b"M4B ", b"M4P "):
+            return "audio/mp4"
+        if brand == b"qt  ":
+            return "video/quicktime"
+        return "video/mp4"
+    if media_bytes.startswith(b"\x1a\x45\xdf\xa3"):
+        return fallback if fallback.startswith("audio/") else "video/webm"
+    return fallback
+
+
+def media_filename(mime: str) -> str:
+    """Give Gemini's attachment slot a filename that matches the media type."""
+    mime = (mime or "").split(";", 1)[0].strip().lower()
+    if mime.startswith("image/"):
+        return "image.png"
+    return _MEDIA_FILENAMES.get(mime, "file.bin")
+
+
