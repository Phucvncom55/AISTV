# Token bot Telegram (lấy từ @BotFather) — KHÔNG commit file này
# run.sh / run.bat hỏi một lần rồi lưu vào đây VÀ ~/.config/aistv/config.env
TELEGRAM_BOT_TOKEN=

# Danh sách user id Telegram được phép dùng bot, cách nhau bằng dấu phẩy.
# Lấy user id của bạn bằng @userinfobot. Để trống = người nhắn đầu tiên thành chủ bot
# (hoặc để run.sh tự xác nhận qua link https://t.me/<bot>?start=<mã>).
ALLOWED_USER_IDS=

# Tuỳ chọn
# STV_HOME=/content/stv_agent
# AISTV_CONFIG_DIR=~/.config/aistv   # nơi lưu config.env dùng chung
# AISTV_PAIR=0                     # bỏ bước chờ bấm Start
# AISTV_PAIR_TIMEOUT=180           # giây chờ xác nhận chủ bot
# AISTV_PROMPT_TIMEOUT=180         # giây chờ nhập token/key
# AISTV_ASK_GEMINI=0               # 1 = hỏi Gemini key trong terminal (mặc định không hỏi)
# OPENCODE_BIN=/root/.opencode/bin/opencode
# AISTV_CLEAN_INSTALL=0

# ── Trí nhớ đám mây & chủ động (tuỳ chọn) ──
# AISTV_FIREBASE_URL=https://<project>-default-rtdb.firebaseio.com
# AISTV_CLOUD=0            # tắt đồng bộ cloud
# AISTV_CLOUD_NS=aistv     # namespace gốc
# AISTV_FIREBASE_SECRET=   # chỉ khi Rules yêu cầu auth
# AISTV_AUTO_SUMMARY=0     # tắt tự tóm tắt hội thoại
# AISTV_PROACTIVE=0        # tắt nhắc việc & theo dõi
# AISTV_WATCH_SELF=0       # không tự theo dõi log bot

# ── Khung tiến độ kiểu terminal (tuỳ chọn) ──
# AISTV_PROGRESS_TICK=1    # giây giữa 2 lần cập nhật
# AISTV_PROGRESS_LINES=14  # số dòng cuộn; dòng cũ rơi khỏi đỉnh

# ── Mạng xã hội (tuỳ chọn) ──
# FB_COOKIES=/duong/dan/fb_cookies.txt
# TIKTOK_COOKIES=/duong/dan/tiktok_cookies.txt
# YT_COOKIES=/duong/dan/cookies.txt   # YouTube chặn IP ("confirm you're not a bot")
# JINA_API_KEY=            # tăng hạn mức đọc web cho tìm kiếm

# ── Email (IMAP/SMTP) — tuỳ chọn ──
# AISTV_EMAIL_ADDRESS=ban@gmail.com
# AISTV_EMAIL_PASSWORD=mat-khau-ung-dung-16-ky-tu
# AISTV_EMAIL_IMAP_HOST=imap.gmail.com
# AISTV_EMAIL_IMAP_PORT=993
# AISTV_EMAIL_SMTP_HOST=smtp.gmail.com
# AISTV_EMAIL_SMTP_PORT=587

# ── Gemini: mắt + tai cho ảnh/video (tuỳ chọn, miễn phí) ──
# Lấy key tại https://aistudio.google.com/apikey rồi dán vào đây.
# Có thể thêm GEMINI_API_KEY vào Colab Secrets thay vì file này.
# GEMINI_API_KEY=
# Model chính: Gemini 3 Flash (preview) hoặc gemini-2.5-flash.
# WATCH_GEMINI_MODEL=gemini-3-flash-preview
# Model dự phòng khi model chính chưa mở / hết hạn mức (cách nhau dấu phẩy).
# WATCH_GEMINI_FALLBACKS=gemini-2.5-flash,gemini-3.1-flash-lite
# Hạn mức miễn phí tham khảo: 10 RPM, 1500 RPD. Bot tự giữ nhịp để tránh 429.
# GEMINI_RPM=10
# GEMINI_RPD=1500
# GEMINI_MAX_RETRIES=2
# Chặn treo: mỗi lần gọi tối đa GEMINI_TIMEOUT giây, cả chuỗi model + retry
# tối đa GEMINI_DEADLINE giây rồi báo lỗi thay vì chờ mãi.
# GEMINI_TIMEOUT=120
# GEMINI_DEADLINE=300
# GEMINI_QUOTA_DISABLE=0   # 1 = tắt theo dõi hạn mức cục bộ
# GEMINI_QUOTA_FILE=       # mặc định ~/.config/aistv/gemini_quota.json
# WATCH_MAX_IMAGE_MB=50    # ảnh tải từ URL
# WATCH_INLINE_IMAGE_MB=12 # ảnh nhỏ hơn gửi trực tiếp, lớn hơn dùng Files API
# AISTV_IMAGE_TIMEOUT=600  # giây tối đa đọc ảnh trong chat
# AISTV_VIDEO_TIMEOUT=900  # giây tối đa xem video trong chat
# GROQ_API_KEY=            # transcript dự phòng
# OPENAI_API_KEY=          # transcript dự phòng
# WATCH_MAX_MB=600         # giới hạn dung lượng video tải về
