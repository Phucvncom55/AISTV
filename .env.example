# Token bot Telegram (lấy từ @BotFather) — KHÔNG commit file này
TELEGRAM_BOT_TOKEN=

# Danh sách user id Telegram được phép dùng bot, cách nhau bằng dấu phẩy.
# Lấy user id của bạn bằng @userinfobot. Để trống = người nhắn đầu tiên thành chủ bot.
ALLOWED_USER_IDS=

# Tuỳ chọn
# STV_HOME=/content/stv_agent
# OPENCODE_BIN=/root/.opencode/bin/opencode
# AISTV_CLEAN_INSTALL=0

# ── Trí nhớ đám mây & chủ động (tuỳ chọn) ──
# AISTV_FIREBASE_URL=https://<project>-default-rtdb.firebaseio.com
# AISTV_CLOUD=0            # tắt đồng bộ cloud
# AISTV_CLOUD_NS=aistv     # namespace gốc
# AISTV_FIREBASE_SECRET=   # chỉ khi Rules yêu cầu auth
# AISTV_AUTO_SUMMARY=0     # tắt tự tóm tắt hội thoại
# AISTV_PROACTIVE=0        # tắt nhắc việc & theo dõi
# AISTV_WATCH_SELF=0       # không tự theo dõi log bot

# ── Khung tiến độ kiểu terminal (tuỳ chọn) ──
# AISTV_PROGRESS_TICK=1    # giây giữa 2 lần cập nhật
# AISTV_PROGRESS_LINES=14  # số dòng cuộn; dòng cũ rơi khỏi đỉnh

